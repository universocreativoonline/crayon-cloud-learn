# ============================================================================
# Pinturitas · variables de entorno
# Copia este archivo como .env y rellena con los datos de TU proyecto Supabase.
# Las VITE_* llegan al navegador: aquí SOLO va la clave pública/publishable.
# NUNCA pongas aquí la service_role.
# ============================================================================

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=TU_CLAVE_PUBLICA
VITE_SUPABASE_PROJECT_ID=TU-PROYECTO

# Mismo valor, sin el prefijo VITE_ (lo usan algunas herramientas del build).
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=TU_CLAVE_PUBLICA
SUPABASE_PROJECT_ID=TU-PROYECTO

# ---------------------------------------------------------------------------
# Pendientes de conectar (ver README):
#   HOTMART_WEBHOOK_SECRET=   # pagos
#   RESEND_API_KEY=           # correos transaccionales
# ---------------------------------------------------------------------------
